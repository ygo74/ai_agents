# Secrets are read by the model SDK; do not put them in YAML or command arguments.
OPENAI_API_KEY=
CREDIT_MODEL=
CREDIT_MODEL_PROVIDER=openai
# HTTP host authentication; supply a secret value to enable serving.
CREDIT_AGENT_HTTP_API_KEY=
# Bounded process-local conversation cache (one worker, no restart persistence).
CREDIT_AGENT_HTTP_MAX_CONVERSATIONS=200
CREDIT_AGENT_HTTP_IDLE_MINUTES=30
# Set an absolute path to the server executable in its isolated environment.
CREDIT_MCP_COMMAND=
EDGAR_IDENTITY=Your organization contact@example.com
EDGAR_LOCAL_DATA_DIR=/tmp/credit-edgar-data
EDGAR_RATE_LIMIT_PER_SEC=5
# Azure variant:
# CREDIT_MODEL_PROVIDER=azure_openai
# CREDIT_MODEL=deployment-name
# CREDIT_AZURE_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
