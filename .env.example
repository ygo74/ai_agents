# ---------------------------------------------------------------------------
# AI Agent Lab - example configuration
#
# Copy this file to `.env` and fill in the values.
# NEVER commit a real `.env` file: it is excluded by .gitignore.
# ---------------------------------------------------------------------------

# --- Mail agent runtime mode -----------------------------------------------
# mock  : the agent talks to an in-memory dataset (no Gmail, no network)
# mcp   : the agent talks to a real Mail MCP server
MAIL_AGENT_MODE=mock

# Dataset used by the `mock` mode.
MAIL_AGENT_MOCK_DATASET=data/mail/sample_mailbox.json

# --- Local user identity (PoC only) ----------------------------------------
# Identifies the mailbox owner inside the mock dataset and in audit records.
# No credential ever belongs here.
MAIL_AGENT_USER_ID=local-user
MAIL_AGENT_USER_EMAIL=local-user@example.com

# --- Mail MCP server (used when MAIL_AGENT_MODE=mcp) ------------------------
# Which delivered binding to use: config/mcp/<name>.yaml
#   local : the reference server, over stdio, backed by the dataset
#   gmail : the official Google Gmail MCP server, remote over HTTP
MAIL_MCP_SERVER=local
MAIL_MCP_REQUEST_TIMEOUT_SECONDS=30

# OAuth client used to reach a remote MCP server such as the official Gmail one.
# Create it in Google Cloud console > Google Auth Platform > Clients, as a
# "Web application", and register the redirect URI below.
# NEVER paste these values anywhere but this file.
MAIL_MCP_OAUTH_CLIENT_ID=
MAIL_MCP_OAUTH_CLIENT_SECRET=
# Must match the authorised redirect URI of the OAuth client:
#   http://localhost:8765/oauth/callback
MAIL_MCP_OAUTH_CALLBACK_PORT=8765
# Where the issued tokens are kept. Excluded by .gitignore.
MAIL_MCP_OAUTH_TOKEN_FILE=.secrets/mail-mcp-token.json
# Scopes requested, space separated. These are pinned: the MCP SDK would
# otherwise request everything the server advertises, which for Gmail includes
# https://mail.google.com/ - full mailbox control, permanent deletion included.
# Applying labels or archiving additionally needs gmail.modify, which must also
# be added to the consent screen.
MAIL_MCP_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose

# --- Gmail API (used when MAIL_MCP_SERVER=gmail-api) ------------------------
# Our own MCP server reaches Gmail through its REST API, which is generally
# available - unlike the official Gmail MCP server, which requires Google
# Workspace Developer Preview enrolment.
# Create a "Web application" OAuth client and register this redirect URI:
#   http://localhost:8765/oauth/callback
# The client already used for MAIL_MCP_OAUTH_* works: copy the same values here.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_CALLBACK_PORT=8765
GMAIL_OAUTH_TOKEN_FILE=.secrets/gmail-token.json
# Reading and drafting need the first two; the label operations need the third.
GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.modify

# --- Confirmation policy overrides -----------------------------------------
# Comma-separated tool names that never require confirmation for this user.
# Everything classified as WRITE requires confirmation unless listed here.
#
# Useful when a request touches many messages at once: labelling a whole thread
# otherwise asks once per message. Answering "a" at a prompt does the same thing
# for one conversation; this makes it stick.
#   MAIL_AGENT_AUTO_APPROVED_TOOLS=apply_label,remove_label,mark_read
#
# One capability ignores this list: send_mail is on the security floor and
# always asks. Delivering an email cannot be taken back.
MAIL_AGENT_AUTO_APPROVED_TOOLS=
# Comma-separated tool names that always require confirmation, even if the
# default policy would not ask. Takes precedence over auto-approved tools.
MAIL_AGENT_ALWAYS_CONFIRM_TOOLS=

# --- Model / chat client ---------------------------------------------------
# Which provider backs the agent: openai | azure_openai
# This is explicit on purpose. The Agent Framework client stays on OpenAI
# whenever OPENAI_API_KEY is set, even when the AZURE_OPENAI_* values below are
# filled in, so an implicit choice would silently ignore an Azure deployment.
AGENT_CHAT_PROVIDER=openai

# Sampling temperature of the analysis skills. Leave empty to omit it: reasoning
# models reject the parameter. Set it to 0 with a classic model for repeatable
# measurements.
AGENT_CHAT_TEMPERATURE=

# The chat client reads the keys itself. The application never holds one.
#
# OpenAI (AGENT_CHAT_PROVIDER=openai):
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
#
# Azure OpenAI (AGENT_CHAT_PROVIDER=azure_openai):
# AZURE_OPENAI_CHAT_MODEL is the deployment name, not the model name.
# The endpoint accepts the resource URL as well as a complete .../openai/v1 URL.
# Do not set AZURE_OPENAI_BASE_URL: the client refuses both at once.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_MODEL=
AZURE_OPENAI_API_VERSION=
# How to authenticate: api_key | azure_cli | default
# api_key reads AZURE_OPENAI_API_KEY; the other modes use Entra ID and need the
# 'azure' extra, so no key exists at all.
AZURE_OPENAI_CREDENTIAL=api_key
AZURE_OPENAI_API_KEY=

# --- Observability ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
MAIL_AGENT_LOG_LEVEL=INFO


# ===========================================================================
# WIKI AGENT (LangChain / LangGraph)
#
# A second agent, on a second framework, over the same core. It reads the same
# model settings as the Mail Agent - AGENT_CHAT_PROVIDER and the OPENAI_* /
# AZURE_OPENAI_* values above - because a comparison between two frameworks is
# only meaningful when both run against the same model.
#
# It has its own virtual environment:
#   py -3.12 -m scripts.install --env wiki-agent --into .venvs\wiki-agent
# ===========================================================================

# --- Wiki agent runtime mode ------------------------------------------------
# mock  : an in-memory dataset (no Confluence, no credentials, no network)
# mcp   : a real wiki MCP server
WIKI_AGENT_MODE=mock

# Dataset used by the `mock` mode. It is deliberately untidy: pages contradict
# each other, one is stale, one is archived, one is restricted to another user,
# and one carries a prompt injection.
WIKI_AGENT_MOCK_DATASET=data/wiki/sample_wiki.json

# --- Local user identity (PoC only) -----------------------------------------
# Identifies the reader inside the mock dataset and in audit records.
# The delivered dataset knows two accounts:
#   diana : may read every space, including BOARD and the restricted page
#   alice : may not read the BOARD space nor apollo-salaries
# Switching between them is the quickest way to see the authorisation rules work.
WIKI_AGENT_USER_ID=diana

# --- Wiki MCP server (used when WIKI_AGENT_MODE=mcp) ------------------------
# Which delivered binding to use: config/mcp/<name>.yaml
#   wiki-local         : our reference server, over stdio, backed by the dataset
#   mcp-atlassian      : sooperset/mcp-atlassian in Docker, over stdio
#   mcp-atlassian-http : the same server, over streamable HTTP, per-user identity
WIKI_MCP_SERVER=wiki-local
WIKI_MCP_TIMEOUT_SECONDS=30

# --- Identity: how the agent tells the server who is asking -----------------
#
# This is the most consequential setting of the whole integration. A wiki
# restricts pages and spaces per person, so an agent acting as a shared service
# account reads pages the user cannot see and summarises them back in good faith.
#
# none   : the transport carries no identity. Right for wiki-local, which passes
#          the caller as a tool argument, and for a stdio mcp-atlassian, which
#          holds one credential and acts as one person.
# basic  : Confluence Cloud, `Basic <base64(email:api_token)>`
# token  : Confluence Data Center, `Token <personal access token>`
# bearer : either, with OAuth. WARNING: the server silently downgrades this to a
#          Data Center PAT when it has no OAuth configuration, so a deployment
#          that meant OAuth and forgot to configure it authenticates differently
#          without failing. Say `token` when a PAT is what you mean.
WIKI_MCP_AUTH_SCHEME=none

# The credential of the local user, sent as the header above.
#
# This is where the proof of concept stops: there is one local user and no
# identity provider, so the credential is configured. Serving several people
# means minting an on-behalf-of token for the authenticated caller — a change to
# WikiUserCredentials alone, invisible above the MCP boundary.
#
# WIKI_MCP_USER_ACCOUNT is the account email, needed by `basic` only.
WIKI_MCP_USER_ACCOUNT=
WIKI_MCP_USER_SECRET=

# Which account a single-identity stdio connection acts for.
#
# Only meaningful when WIKI_MCP_AUTH_SCHEME=none against mcp-atlassian over
# stdio: naming the person the credentials belong to lets the dialect refuse to
# serve anybody else, rather than returning their view of the wiki under
# somebody else's name. Leave empty for wiki-local and for the HTTP binding.
WIKI_MCP_ACCOUNT_ID=

# --- Confluence (used when WIKI_MCP_SERVER=mcp-atlassian) -------------------
# These are read by the MCP server process, never by the agent. The binding in
# config/mcp/mcp-atlassian.yaml names them; their values reach the container and
# nothing else.
#
# Cloud, today. Create the token at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USERNAME=you@example.com
CONFLUENCE_API_TOKEN=
#
# Data Center, later. Same file, same tools, same agent code: replace the three
# values above with these two, and edit the `env:` block of the binding.
#   CONFLUENCE_URL=https://confluence.your-company.example
#   CONFLUENCE_PERSONAL_TOKEN=<personal access token>
#
# Cloud OAuth is deliberately not used: Atlassian removed the v1 REST endpoints
# from the api.atlassian.com gateway in August 2026 and that path now returns
# 410 Gone. The API token is unaffected. See docs/wiki-mcp-servers.md.

# The one switch that decides whether this agent may change a wiki.
#
# It does two things at once, and that is the point. The value is handed to the
# MCP server process, which exposes no write tool when it is true; and the agent
# reads it through `read_only_variable` in the binding, withdrawing the four
# write capabilities instead of offering edits the server would refuse.
#
# Setting only one of the two used to be possible, and produced the worst
# outcome: the agent drafted a page, asked you to approve publishing it, and
# only then discovered the tool did not exist.
#
# It stays `true` here. Writing to a real Confluence the first time somebody runs
# the agent is not a default worth having. Set it to `false` when writing is what
# the deployment is for; the toolsets below already carry the page and comment
# tools the write capabilities need.
#
# Anything other than false/0/no/off reads as read-only, so a typo costs you a
# refusal rather than an unintended edit.
WIKI_MCP_READ_ONLY=true
WIKI_MCP_TOOLSETS=confluence_pages,confluence_comments

# --- Freshness thresholds ---------------------------------------------------
# When documentation stops being trustworthy, in days since its last change.
# A judgement about a particular body of documentation - a coding standard ages
# slowly, a sprint plan ages in weeks - so it is configuration.
WIKI_FRESHNESS_AGEING_AFTER_DAYS=90
WIKI_FRESHNESS_STALE_AFTER_DAYS=180

# --- Confirmation policy overrides ------------------------------------------
# Same semantics as the mail equivalents above. Nothing is gated in the current
# increment because every delivered capability is read-only; update_page and
# delete_page sit on the security floor and will always ask.
WIKI_AGENT_AUTO_APPROVED_TOOLS=
WIKI_AGENT_ALWAYS_CONFIRM_TOOLS=

# --- Observability ----------------------------------------------------------
WIKI_AGENT_LOG_LEVEL=INFO
