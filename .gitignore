# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments (one per agent / per framework)
.venvs/
.venv/
venv/
env/

# Secrets and local configuration - NEVER commit
.env
.env.*
!.env.example
credentials.json
token.json
*.pem
*.key
secrets/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors / OS
#
# The contents of `.vscode/` rather than the directory itself: git cannot
# re-include a file whose parent directory is excluded, and the debug
# configurations below are project tooling rather than personal preference.
# Every agent has its own virtual environment, and a colleague guessing which
# interpreter to point at is a colleague debugging the wrong one.
.vscode/*
!.vscode/launch.json
.idea/
Thumbs.db
.DS_Store

# OAuth tokens issued for remote MCP servers
.secrets/
